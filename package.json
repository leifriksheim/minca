{
  "name": "minca",
  "private": true,
  "type": "module",
  "description": "Minca: the protocol, its CLI and relay, and the apps built on it",
  "workspaces": [
    "packages/core",
    "packages/relay",
    "packages/cli",
    "packages/ui",
    "packages/calls",
    "packages/react",
    "apps/*",
    "scenarios"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "minca": "node --env-file=packages/cli/.env.dev --conditions=@minca/source --import tsx packages/cli/src/main.ts",
    "signal": "node packages/relay/signaling-server.mjs",
    "build": "npm run build -w @minca/core && npm run bundle -w @minca/cli",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "scenarios": "npm run scenarios -w @minca/scenarios",
    "release": "node scripts/release.mjs",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fallow": "fallow dead-code",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run fallow",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "bumpp": "^12.3.0",
    "fallow": "^3.33.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
