# Defaults for production builds. Override in the host's environment settings.
# The public relays: the home and the apps it serves must share one to sync.
VITE_SIGNALING_URL=wss://minca.fly.dev,nostr+wss://relay.damus.io

# The host this build offers under "Keep my spaces online", and restores accounts from
# (packages/cli/fly.toml). Set it once the host is deployed:
VITE_MINCA_HOST=https://minca-host.fly.dev

# Where new accounts claim usernames (packages/names, deployed as minca-names).
VITE_NAMES_DOMAIN=minca.social
