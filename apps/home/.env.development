# Defaults for `npm run dev`. Override in home/.env.local (not committed).
# The same relays as the example, so the home and the apps it serves meet.
VITE_SIGNALING_URL=ws://localhost:8787,wss://relay.minca.social
VITE_MINCA_NODES=ws://localhost:8787/peer,ws://localhost:8788/peer
VITE_MINCA_HOST=http://localhost:8788

# Where new accounts claim usernames: `npm run dev` starts a name service on 8789.
VITE_NAMES_DOMAIN=localhost:8789
