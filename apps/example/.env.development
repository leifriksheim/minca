# Defaults for `npm run dev`. Override any of these in example/.env.local (not committed).

# Where peers meet — several at once, and a peer found through any of them
# counts. The local one is the node `npm run dev` starts (it is a relay too);
# the public one is how this tab meets the deployed app, or a phone.
VITE_SIGNALING_URL=ws://localhost:8787,wss://minca.fly.dev

# Always-on nodes to keep a socket to. Remove it to test browsers alone.
VITE_MINCA_NODES=ws://localhost:8788/peer,ws://localhost:8787/peer

# The account home this app connects to: `npm run dev` starts one on 5174.
VITE_MINCA_HOME=http://localhost:5174/connect

# What "Connect an agent" tells you to run: the CLI from this repo, at the home `npm run dev` starts.
VITE_MINCA_CONNECT=npm run minca -- connect --account-home localhost:5174



# The host "Keep online" suggests, and where a new device looks for its account: `npm run dev` starts one on 8788.
VITE_MINCA_HOST=http://localhost:8788
