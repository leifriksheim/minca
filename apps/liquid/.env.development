# Defaults for `npm run dev`. Override any of these in liquid/.env.local (not committed).

# Where peers meet. The local one is the node `npm run dev` starts (it is a relay too).
VITE_SIGNALING_URL=ws://localhost:8787,wss://relay.minca.social

# Always-on nodes to keep a socket to.
VITE_MINCA_NODES=ws://localhost:8788/peer,ws://localhost:8787/peer

# The account home this app connects to: `npm run dev` starts one on 5174.
VITE_MINCA_HOME=http://localhost:5174/connect

# Where a new device looks for its account: `npm run dev` starts one on 8788.
VITE_MINCA_HOST=http://localhost:8788
