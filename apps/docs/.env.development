# Defaults for `npm run dev`: the playground connects to the Minca that
# `npm run dev` at the root starts. Override any of these in .env.local (not committed).

# The account home: `npm run dev` starts one on 5174.
NEXT_PUBLIC_MINCA_HOME=http://localhost:5174/connect

# Where peers meet. The local one is the node `npm run dev` starts (it is a relay too).
NEXT_PUBLIC_MINCA_RELAYS=ws://localhost:8787,wss://relay.minca.social

# Always-on nodes to keep a socket to, and the host new accounts are kept online with.
NEXT_PUBLIC_MINCA_NODES=ws://localhost:8788/peer,ws://localhost:8787/peer
NEXT_PUBLIC_MINCA_HOSTS=http://localhost:8788
