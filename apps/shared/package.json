{
  "name": "@minca/app-shared",
  "private": true,
  "type": "module",
  "description": "What the example app, the account home and the mini apps share: styles and shapes built on the design system (@minca/ui), the relay configuration, a few components, and the mini app contract. Source only; each app's Vite build compiles it.",
  "exports": {
    "./styles": "./src/styles.ts",
    "./shapes": "./src/shapes.tsx",
    "./relay": "./src/relay.ts",
    "./Avatar": "./src/Avatar.tsx",
    "./Info": "./src/Info.tsx",
    "./SpaceHosting": "./src/SpaceHosting.tsx",
    "./HostAddress": "./src/HostAddress.tsx",
    "./HostOffer": "./src/HostOffer.tsx",
    "./Modal": "./src/Modal.tsx",
    "./Ask": "./src/Ask.tsx",
    "./Loader": "./src/Loader.tsx",
    "./Wordmark": "./src/Wordmark.tsx",
    "./mark": "./src/mark.ts",
    "./useDismiss": "./src/useDismiss.ts",
    "./action": "./src/action.ts",
    "./places": "./src/places.ts",
    "./Payment": "./src/Payment.tsx",
    "./CommunitySetup": "./src/CommunitySetup.tsx",
    "./Feature": "./src/Feature.tsx",
    "./may": "./src/may.ts",
    "./usernames": "./src/usernames.ts",
    "./UsernamePicker": "./src/UsernamePicker.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@minca/core": "*",
    "@minca/react": "*",
    "qrcode-generator": "^2.0.4",
    "@minca/ui": "*"
  }
}
