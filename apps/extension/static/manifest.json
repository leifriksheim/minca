{
  "manifest_version": 3,
  "name": "Minca",
  "short_name": "Minca",
  "version": "0.1.4",
  "description": "Keeps your Minca spaces online while your browser is open. It can't read them.",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Minca",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["offscreen", "alarms", "unlimitedStorage"]
}
