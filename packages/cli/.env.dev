# The dev node: a throwaway local identity for `npm run dev` and `npm run minca`.
# Not a secret worth keeping — it guards test data in .minca-dev/ on this machine
# only. A real node takes its passphrase from somewhere private
# (see cli/minca-node.service).
MINCA_HOME=.minca-dev
MINCA_PASSPHRASE=dev-only-not-a-secret
PORT=8787
