# The dev host that `npm run dev` starts on port 8788: what "Keep my spaces
# online" in the home talks to (home/.env.development points at it).
# Put your own settings in cli/.env.host.local (not committed); it wins.
PORT=8788
MINCA_HOST_DATA=.minca-dev/host
MINCA_HOST_NAME=Dev host

# Crypto wallet payments on Base Sepolia, the test network: test USDC, no real
# money. The address only receives; set your own in .env.host.local to watch
# payments arrive (0x…dEaD is nobody's).
MINCA_WALLET_NETWORK=base-sepolia
MINCA_WALLET_ADDRESS=0x000000000000000000000000000000000000dEaD

# In .env.host.local, optionally:
#
# Card payments, in Stripe's test mode (no real money; card 4242 4242 4242 4242).
# `npm run dev` forwards Stripe's webhooks here with the Stripe CLI by itself.
#   STRIPE_SECRET_KEY=sk_test_…

# Bots the host runs for the spaces it carries ("Set up this community", Add a
# bot), paid from the community's fund. In .env.host.local, with a key of yours:
#   MINCA_HOST_BOTS=1
#   ANTHROPIC_API_KEY=sk-ant-…
# or with OpenAI, or any server that speaks Chat Completions (MINCA_BOT_BASE_URL),
# at its price in dollars per million tokens, input/output:
#   MINCA_HOST_BOTS=1
#   MINCA_BOT_PROVIDER=openai
#   OPENAI_API_KEY=sk-…
#   MINCA_BOT_MODEL=gpt-5.5
#   MINCA_BOT_PRICE=<input>/<output>
#
# Connecting those bots to GitHub (packages/core/docs/bots.md, "GitHub, in the
# reference host"), with a GitHub App of yours whose callback URL is
# http://localhost:8788/host/connect/github/callback. A webhook needs an
# address GitHub can reach, so leave it off here:
#   MINCA_HOST_URL=http://localhost:8788
#   MINCA_GITHUB_APP_ID=…
#   MINCA_GITHUB_APP_SLUG=…
#   MINCA_GITHUB_CLIENT_ID=…
#   MINCA_GITHUB_CLIENT_SECRET=…
#   MINCA_GITHUB_PRIVATE_KEY=/path/to/the-app.private-key.pem
# MINCA_HOST_FREE=1 runs the bots without a funded community, on this machine only.
