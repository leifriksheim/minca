{
  "name": "@minca/cli",
  "version": "0.1.16",
  "description": "The Minca protocol from a terminal: manage spaces, run an always-on node, serve MCP to agents",
  "type": "module",
  "bin": {
    "minca": "dist/minca.mjs"
  },
  "scripts": {
    "start": "node --conditions=@minca/source --import tsx src/main.ts",
    "test": "node --conditions=@minca/source --import tsx --test --test-concurrency=8 --test-timeout=60000 --test-force-exit tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "eval": "node --conditions=@minca/source --import tsx evals/collections.ts",
    "bundle": "node scripts/bundle.mjs",
    "build": "bun build.mjs",
    "prepublishOnly": "npm run bundle"
  },
  "dependencies": {
    "node-datachannel": "^0.33.4",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leifriksheim/minca.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist/minca.mjs",
    "README.md"
  ],
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@clack/prompts": "^1.8.1",
    "@minca/core": "*",
    "@minca/relay": "*",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/node": "^26.6.5",
    "@types/oidc-provider": "^9.13.1",
    "add-mcp": "2.4.1",
    "esbuild": "^0.28.0",
    "jose": "^6.2.15",
    "oauth4webapi": "^3.8.8",
    "oidc-provider": "^9.13.3",
    "tsx": "^4.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
