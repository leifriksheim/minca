{
  "name": "@minca/cli",
  "version": "0.1.13",
  "description": "The Minca protocol from a terminal: manage spaces, run an always-on node, serve MCP to agents",
  "type": "module",
  "bin": {
    "minca": "dist/minca.mjs"
  },
  "scripts": {
    "start": "node --conditions=@minca/source --import tsx src/main.ts",
    "test": "node --conditions=@minca/source --import tsx --test --test-concurrency=4 --test-timeout=60000 --test-force-exit tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "eval": "node --conditions=@minca/source --import tsx evals/collections.ts",
    "bundle": "esbuild src/main.ts --bundle --platform=node --format=esm --main-fields=module,main --target=node22 --conditions=@minca/source --outfile=dist/minca.mjs --external:ws --external:node-datachannel --banner:js='#!/usr/bin/env node\nimport { createRequire } from \"node:module\";\nconst require = createRequire(import.meta.url);'",
    "build": "bun build.ts",
    "prepublishOnly": "npm run bundle"
  },
  "dependencies": {
    "node-datachannel": "^0.33.4",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leifriksheim/minca.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist/minca.mjs",
    "README.md"
  ],
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@clack/prompts": "^1.8.1",
    "@minca/core": "*",
    "@minca/relay": "*",
    "@types/node": "^26.6.5",
    "add-mcp": "2.4.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
