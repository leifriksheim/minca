{
  "name": "@minca/core",
  "version": "0.3.1",
  "type": "module",
  "description": "The Minca protocol: identity, signed records, spaces, the network and sync, and a node that holds them",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leifriksheim/minca.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "@minca/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "@minca/source": "./src/schemas/index.ts",
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./inbox": {
      "@minca/source": "./src/inbox/index.ts",
      "types": "./dist/inbox/index.d.ts",
      "import": "./dist/inbox/index.js"
    },
    "./utils": {
      "@minca/source": "./src/utils/index.ts",
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit && tsc -p tests",
    "test": "node --experimental-vm-modules --conditions=@minca/source --import tsx --test --test-concurrency=8 --test-timeout=60000 --test-force-exit tests/*.test.ts",
    "prepack": "node ../../scripts/npm-readme.mjs",
    "postpack": "rm -f README.md",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@minca/actions": "*",
    "@minca/auth": "*",
    "@minca/session": "*",
    "@minca/std": "*",
    "@minca/storage": "*",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
